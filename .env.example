# Host port bound only to 127.0.0.1 for a reverse proxy such as Nginx or Caddy.
APP_PORT=8787

# Refresh a stored Facebook album manifest after this many minutes.
ALBUM_CACHE_TTL_MINUTES=30

# Keep CPU-heavy OCR bounded. These defaults suit an 8-vCPU server and leave
# capacity for the API, Facebook browser discovery, and the operating system.
OCR_MAX_CONCURRENT=1
OCR_MAX_QUEUE=25
OCR_TORCH_THREADS=6
TORCH_NUM_INTEROP_THREADS=1
OMP_NUM_THREADS=6
MKL_NUM_THREADS=6
OPENBLAS_NUM_THREADS=1

# The browser origin allowed to call the API (a URL path is not included here).
ALLOWED_ORIGINS=https://rathpiseyalpha.github.io

# Required to use the unlinked /admin archive importer. Generate a long random
# value, for example: openssl rand -hex 32
ADMIN_TOKEN=

# Host directory containing one ignored archive folder per year. The expected
# layout is bacii-2026/bacii-2026.sqlite plus bacii-2026/pdfs/*.pdf.
BACII_ARCHIVE_HOST_PATH=./data
